{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nexus-license-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "NEXUS_DB",
			"database_name": "nexus-license-db",
			"database_id": "ea1920d4-38b8-49d3-af21-91b3eaea6d2d",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"PRODUCT_NAME": "NEXUS",
		"ALLOWED_ORIGIN": "https://highcloudnexus.com",
		"STRIPE_TEST_PRICE_30_DAY": "price_1TvAJDP0C6hxVoRDSJlypSTW",
		"STRIPE_TEST_PRICE_LIFETIME": "price_1TvANHP0C6hxVoRDWXzvd7Sb",
		"STRIPE_LIVE_PRICE_30_DAY": "price_1TvmcS1P38omiwEhPcTbmOTs",
		"STRIPE_LIVE_PRICE_LIFETIME": "price_1TvmcU1P38omiwEhnBQ1UMiy",
		"LATEST_VERSION": "1.6.11",
		"LATEST_PACKAGE_URL": "https://github.com/3zva/NEXUSPROJECT/releases/latest/download/NEXUS.exe",
		"LATEST_PACKAGE_SHA256": "575d7084258753c8db8028217bdea6bc6b4220ed99891f42c1f22af271870acc",
		"LATEST_PACKAGE_SIZE": "46470516",
		"MINIMUM_WINDOWS_BUILD": "19045",
		"SETUP_DOWNLOAD_URL": "https://github.com/3zva/NEXUSPROJECT/releases/latest/download/NEXUS.exe"
	},
	"secrets": {
		"required": [
			"STRIPE_TEST_SECRET_KEY",
			"STRIPE_LIVE_SECRET_KEY",
			"STRIPE_TEST_WEBHOOK_SECRET",
			"STRIPE_LIVE_WEBHOOK_SECRET",
			"LICENSE_HASH_PEPPER",
			"LICENSE_ENCRYPTION_KEY_B64",
			"LICENSE_SIGNING_PRIVATE_JWK"
		]
	}
}
