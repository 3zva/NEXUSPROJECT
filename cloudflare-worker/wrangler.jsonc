{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nexus-license-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "NEXUS_DB",
			"database_name": "nexus-license-db",
			"database_id": "REPLACE_WITH_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		},
		{
			"binding": "nexus_license_db",
			"database_name": "nexus-license-db",
			"database_id": "ea1920d4-38b8-49d3-af21-91b3eaea6d2d",
			"remote": true
		}
	],
	"vars": {
		"PRODUCT_NAME": "NEXUS",
		"ALLOWED_ORIGIN": "https://YOUR-WORDPRESS-SITE.example",
		"STRIPE_PRICE_30_DAY": "price_REPLACE_30_DAY",
		"STRIPE_PRICE_LIFETIME": "price_REPLACE_LIFETIME",
		"LATEST_VERSION": "0.0.0",
		"LATEST_PACKAGE_URL": "https://github.com/YOUR_ACCOUNT/YOUR_REPO/releases/download/v0.0.0/NEXUS-App.zip",
		"LATEST_PACKAGE_SHA256": "REPLACE_SHA256",
		"LATEST_PACKAGE_SIZE": "0",
		"MINIMUM_WINDOWS_BUILD": "19045",
		"SETUP_DOWNLOAD_URL": "https://github.com/YOUR_ACCOUNT/YOUR_REPO/releases/download/v0.0.0/NEXUS-Web-Setup.exe"
	},
	"secrets": {
		"required": [
			"STRIPE_SECRET_KEY",
			"STRIPE_WEBHOOK_SECRET",
			"LICENSE_HASH_PEPPER",
			"LICENSE_ENCRYPTION_KEY_B64",
			"LICENSE_SIGNING_PRIVATE_JWK"
		]
	}
}